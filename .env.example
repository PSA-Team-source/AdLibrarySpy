# AdLibrarySpy configuration. Copy to .env.local and fill in; never commit .env.local.
# Every value below is a placeholder.

# ---- App ----------------------------------------------------------------------
# Public origin: sign-in links, OAuth (MCP) metadata, canonical URLs, sitemap.
APP_BASE_URL=http://localhost:4311
# HMAC key (at least 16 characters) that signs newsletter unsubscribe links.
SESSION_SECRET=replace-with-a-long-random-string
# Reported by /api/health; defaults to "dev".
APP_VERSION=
# Chrome extension listing URL. Unset = the homepage footer shows no extension link.
NEXT_PUBLIC_CHROME_EXTENSION_URL=

# ---- Postgres (required) -------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/adlibraryspy
# TLS is on by default; set to "off" for a local Postgres without TLS.
PGSSL=off
PG_POOL_MAX=10

# ---- Mail (required: sign-in is an emailed magic link) -------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hello@example.com
SMTP_FROM_NAME=AdLibrarySpy

# ---- Market index ----------------------------------------------------------------
# Shops, ads and advertisers are read from this API. Left unchanged, a local
# instance reads the public index at api.platformdtc.com.
MARKET_API_BASE=https://api.platformdtc.com/api/v1
MARKET_TIMEOUT_MS=12000
# Service account for ad creatives and the MCP tools, issued by the index operator.
# Without it, ad creative screens and MCP ad tools are unavailable.
# PLATFORM_JWT_SECRET must be at least 32 bytes.
PLATFORM_JWT_SECRET=
MARKET_SERVICE_ACCOUNT_ID=
MARKET_SERVICE_EMAIL=

# ---- Funnel events (optional) ---------------------------------------------------
# ClickHouse HTTP endpoint for signup/activation events (table in
# lib/analytics/001_adlibraryspy_events.sql). Unset = events are not sent.
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# ---- Traffic data (optional) ----------------------------------------------------
# "similarweb" or "semrush" plus the matching key. Without one, traffic charts show
# only the months the market index stores; nothing is estimated.
TRAFFIC_PROVIDER=
SIMILARWEB_API_KEY=
SEMRUSH_API_KEY=
TRAFFIC_CACHE_DAYS=7

# ---- Weekly report (scripts/weekly-report.mjs) ----------------------------------
# Newsletter send rate, emails per second.
WEEKLY_MAIL_PER_SEC=4
