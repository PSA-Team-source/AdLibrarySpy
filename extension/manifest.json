{
  "manifest_version": 3,
  "name": "AdLibrarySpy — Free Shopify Store & Ad Inspector",
  "short_name": "AdLibrarySpy",
  "version": "1.0.0",
  "description": "Free: see any Shopify store's traffic, live Meta ads, top products and apps in one click.",
  "homepage_url": "https://adlibraryspy.com/?ref=ext:chrome",
  "minimum_chrome_version": "102",
  "action": {
    "default_title": "Inspect this store with AdLibrarySpy",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://adlibraryspy.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
