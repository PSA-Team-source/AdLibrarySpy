{
  "name": "adlibraryspy-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "adlibraryspy-monorepo",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18.17"
      }
    },
    "node_modules/adlibraryspy-mcp": {
      "resolved": "packages/mcp",
      "link": true
    },
    "node_modules/shopify-inspect": {
      "resolved": "packages/shopify-inspect",
      "link": true
    },
    "packages/mcp": {
      "name": "adlibraryspy-mcp",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "shopify-inspect": "^1.0.0"
      },
      "bin": {
        "adlibraryspy-mcp": "server.js"
      },
      "engines": {
        "node": ">=18.17"
      }
    },
    "packages/shopify-inspect": {
      "version": "1.0.0",
      "license": "MIT",
      "bin": {
        "shopify-inspect": "cli.js"
      },
      "engines": {
        "node": ">=18.17"
      }
    }
  }
}
