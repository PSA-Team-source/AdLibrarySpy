{
  "name": "adlibraryspy",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Shopify store and ad intelligence: the AdLibrarySpy web app, CLI, MCP server, Chrome extension and weekly leaderboard.",
  "license": "MIT",
  "homepage": "https://adlibraryspy.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PSA-Team-source/AdLibrarySpy.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 4311",
    "build": "next build",
    "start": "next start -p 4311",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "snapshot": "node scripts/snapshot-trackers.mjs",
    "test": "node --test tests/*.test.mjs packages/*/test.mjs leaderboard/test.mjs",
    "import-crux": "node scripts/import-crux.mjs",
    "leaderboard": "node leaderboard/update.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.32.0",
    "nanoid": "^6.0.1",
    "next": "^15.5.23",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
